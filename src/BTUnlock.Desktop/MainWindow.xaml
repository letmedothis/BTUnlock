<Window x:Class="BTUnlock.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BTUnlock — 人走锁屏"
        Width="480" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12,16,16">

            <!-- 状态 -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="状态" FontSize="13" FontWeight="Bold"/>
                <Button x:Name="CalibrateButton" Grid.Column="1" Content="校准向导…"
                        Padding="10,2" Click="CalibrateButton_Click"/>
            </Grid>
            <Border x:Name="StatusCard" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="StateText" FontSize="22" FontWeight="Bold" Foreground="#6B7280" Text="等待信号"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="平滑 RSSI"/>
                        <TextBlock x:Name="RssiText" Grid.Column="1" Text="—"/>
                        <TextBlock Text="最近采样" Grid.Row="1"/>
                        <TextBlock x:Name="LastSeenText" Grid.Row="1" Grid.Column="1" Text="—"/>
                        <TextBlock Text="蓝牙监听器" Grid.Row="2"/>
                        <TextBlock x:Name="ScannerText" Grid.Row="2" Grid.Column="1" Text="—"/>
                        <TextBlock Text="自动锁屏" Grid.Row="3"/>
                        <TextBlock x:Name="LockEnabledText" Grid.Row="3" Grid.Column="1" Text="—"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 实时 RSSI 曲线（近 3 分钟；红=锁屏阈值 绿=解锁阈值） -->
            <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="4" Padding="4" Margin="0,0,0,14">
                <Canvas x:Name="RssiChart" Height="90" ClipToBounds="True"/>
            </Border>

            <!-- 手机设备 -->
            <TextBlock Text="手机设备" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="已绑定：" VerticalAlignment="Center"/>
                <TextBlock x:Name="BoundDeviceText" VerticalAlignment="Center" FontWeight="Bold" Text="（未绑定）"/>
                <Button x:Name="UnbindButton" Content="解除" Margin="8,0,0,0" Padding="8,2" Click="UnbindButton_Click"/>
            </StackPanel>
            <TextBlock Text="扫描到的手机（打开手机端 App 并开始广播，等待几秒）"
                       FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
            <ListBox x:Name="SeenList" Height="96" Margin="0,0,0,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Button x:Name="BindButton" Content="绑定选中设备" Padding="8,3"
                    HorizontalAlignment="Left" Margin="0,0,0,14" Click="BindButton_Click"/>

            <!-- 安全：滚动令牌 -->
            <TextBlock Text="安全 · 滚动令牌（防信号克隆，解锁必开）" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"
                       Text="手机端 App 会显示 32 位密钥，原样粘贴到这里并保存。启用后，无有效令牌的信号帧将被完全忽略（既不解锁也不阻拦锁屏）；建议同时开启「人来解锁」。"/>
            <TextBox x:Name="TbTokenSecret" Margin="0,0,0,4" FontFamily="Consolas"
                     MaxLength="32" characterCasing="Lower"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="SaveTokenButton" Content="保存密钥" Padding="10,3" Margin="0,0,8,0" Click="SaveTokenButton_Click"/>
                <Button x:Name="ClearTokenButton" Content="清除" Padding="10,3" Click="ClearTokenButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="TokenStatusText" FontSize="11" Foreground="Gray" Text="—" Margin="0,0,0,14"/>

            <!-- 人来解锁 -->
            <TextBlock Text="人来解锁（实验性）" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox x:Name="CbUnlock" Content="启用（需安装解锁组件并录入 Windows 密码，见 docs/04）"
                      Margin="0,0,0,4"
                      Checked="CbUnlock_Changed" Unchecked="CbUnlock_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="UnlockStatusText" VerticalAlignment="Center" Text="未录入"/>
                <Button x:Name="BtnEnroll" Content="录入 / 管理密码…" Margin="8,0,0,0" Padding="8,2" Click="BtnEnroll_Click"/>
            </StackPanel>

            <!-- 触发参数 -->
            <TextBlock Text="触发参数" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="锁屏阈值（dBm）" VerticalAlignment="Center"/>
                <TextBox x:Name="TbLockThreshold" Grid.Column="1" Margin="0,1" />
                <TextBlock Text="低于此值判为离开" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="解锁阈值（dBm）" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="TbUnlockThreshold" Grid.Row="1" Grid.Column="1" Margin="0,1"/>
                <TextBlock Text="高于此值判为回来" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="锁屏驻留（秒）" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="TbLockDwell" Grid.Row="2" Grid.Column="1" Margin="0,1"/>
                <TextBlock Text="需持续低于阈值" Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="解锁驻留（秒）" Grid.Row="3" VerticalAlignment="Center"/>
                <TextBox x:Name="TbUnlockDwell" Grid.Row="3" Grid.Column="1" Margin="0,1"/>
                <TextBlock Text="需持续高于阈值" Grid.Row="3" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="信号丢失超时（秒）" Grid.Row="4" VerticalAlignment="Center"/>
                <TextBox x:Name="TbMissing" Grid.Row="4" Grid.Column="1" Margin="0,1"/>
                <TextBlock Text="收不到广播即锁屏" Grid.Row="4" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            </Grid>
            <Button x:Name="SaveButton" Content="保存参数" Padding="8,3"
                    HorizontalAlignment="Left" Margin="0,4,0,12" Click="SaveButton_Click"/>

            <CheckBox x:Name="AutoLockCheckBox" Content="离开时自动锁屏" Margin="0,0,0,4"
                      Checked="AutoLockCheckBox_Changed" Unchecked="AutoLockCheckBox_Changed"/>
            <CheckBox x:Name="AutoStartCheckBox" Content="开机自启（后台静默启动到托盘）" Margin="0,0,0,10"
                      Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
            <Button x:Name="LockNowButton" Content="立即锁屏（测试）" Padding="8,3"
                    HorizontalAlignment="Left" Click="LockNowButton_Click"/>
            <TextBlock Text="关闭窗口将最小化到托盘；从托盘菜单退出。日志：%APPDATA%\BTUnlock\log.txt"
                       FontSize="11" Foreground="Gray" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
