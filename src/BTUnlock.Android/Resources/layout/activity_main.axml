<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="20dp">

    <TextView
        android:text="BTUnlock 手机端"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:text="保持后台 BLE 广播，供 PC 端判断人走 / 人回"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:textSize="16sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <Button
        android:id="@+id/btnToggle"
        android:text="开始广播"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDeviceId"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tvPairCode"
        android:textSize="13sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:text="小米 / 红米保活设置（逐项完成，一次性）"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAutostart"
        android:text="① 自启动权限 → 开启"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/btnPowerKeeper"
        android:text="② 省电策略 → 无限制"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/btnBattery"
        android:text="③ 电池优化 → 允许（忽略）"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/btnNotification"
        android:text="④ 通知权限 → 允许"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/btnLockRecents"
        android:text="⑤ 最近任务锁定（手动，看说明）"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="说明：手机重启后若广播未自动恢复，通常是①②未生效，回 App 重开一次即可。PC 端绑定手机时，请核对配对码一致。"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
  </LinearLayout>
</ScrollView>
